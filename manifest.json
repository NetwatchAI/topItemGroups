{
	"manifest_version": 2.0,
	"id": "topitemgroups",
	"type": "widget",
	"name": "Top item groups",
	"namespace": "TopItemGroups",
	"version": "1.0",
	"author": "Zabbix",
	"description": "Displays top N item groups (an entity extracted from item names/keys/tags, such as a site, database or mount point) ranked by item value, with configurable columns.",
	"url": "",
	"widget": {
		"js_class": "CWidgetTopItemGroups",
		"in": {
			"hostids": {
				"type": "_hostids"
			},
			"groupids": {
				"type": "_hostgroupids"
			}
		},
		"out": [
			{
				"type": "_hostid"
			},
			{
				"type": "_hostids"
			}
		]
	},
	"actions": {
		"widget.topitemgroups.binary_value.get": {
			"class": "BinaryValueGet",
			"layout": "layout.json"
		},
		"widget.topitemgroups.column.edit": {
			"class": "ColumnEdit",
			"view": "column.edit",
			"layout": "layout.json"
		},
		"widget.topitemgroups.image_value.get": {
			"class": "ImageValueGet",
			"layout": "layout.image"
		},
		"widget.topitemgroups.value.check": {
			"class": "ValueCheck",
			"layout": "layout.json"
		},
		"widget.topitemgroups.view": {
			"class": "WidgetView"
		}
	},
	"assets": {
		"js": ["class.widget.js"]
	}
}
